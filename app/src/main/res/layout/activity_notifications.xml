<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white" android:orientation="vertical">

    <include layout="@layout/layout_top_tabs" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="16dp" android:text="New" android:textColor="@color/text_dark" android:textSize="20sp" android:textStyle="bold" android:tag="t:New" />

            
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/notificationsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" /></LinearLayout>
    </ScrollView>
</LinearLayout>