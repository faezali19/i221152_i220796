<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
        <ImageView android:id="@+id/btnBack" android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="Back" android:src="@drawable/ic_arrow_back" app:tint="@color/text_dark" android:tag="i:ic_arrow_back" />
        <FrameLayout android:layout_width="46dp" android:layout_height="46dp" android:layout_marginStart="8dp">
            <TextView android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/bg_avatar" android:backgroundTint="@color/av_crimson" android:gravity="center" android:text="AK" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" android:id="@+id/chatPersonInitials1" android:tag="t:AK" />
            <View android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="bottom|end" android:background="@drawable/bg_online_dot" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aisha Khan" android:textColor="@color/text_dark" android:textSize="17sp" android:textStyle="bold" android:id="@+id/chatPersonName1" android:tag="t:Aisha Khan" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active now" android:textColor="@color/text_gray" android:textSize="13sp" android:tag="t:Active now" />
        </LinearLayout>
        <ImageView android:id="@+id/btnCall" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginEnd="16dp" android:contentDescription="Voice call" android:src="@drawable/ic_phone" app:tint="@color/primary" android:tag="i:ic_phone" />
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_marginEnd="16dp" android:contentDescription="Video call" android:src="@drawable/ic_video" app:tint="@color/primary" android:tag="i:ic_video" />
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="Info" android:src="@drawable/ic_info" app:tint="@color/primary" android:tag="i:ic_info" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke_light" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/bg_avatar" android:backgroundTint="@color/av_crimson" android:gravity="center" android:text="AK" android:textColor="@color/white" android:textSize="26sp" android:textStyle="bold" android:id="@+id/chatPersonInitials2" android:tag="t:AK" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Aisha Khan" android:textColor="@color/text_dark" android:textSize="22sp" android:textStyle="bold" android:id="@+id/chatPersonName2" android:tag="t:Aisha Khan" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="You're friends on Kinnect · Lives in Karachi" android:textColor="@color/text_gray" android:textSize="14sp" android:tag="t:You\'re friends on Kinnect · Lives in Karachi" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:letterSpacing="0.05" android:text="TODAY 4:49 PM" android:textColor="@color/text_gray" android:textSize="13sp" android:textStyle="bold" android:tag="t:TODAY 4:49 PM" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/messagesList" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" /></LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="More" android:src="@drawable/ic_add_circle" app:tint="@color/primary" android:tag="i:ic_add_circle" />
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_marginStart="12dp" android:contentDescription="Camera" android:src="@drawable/ic_camera" app:tint="@color/primary" android:tag="i:ic_camera" />
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_marginStart="12dp" android:contentDescription="Gallery" android:src="@drawable/ic_image" app:tint="@color/primary" android:tag="i:ic_image" />
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_marginStart="12dp" android:contentDescription="Voice" android:src="@drawable/ic_mic" app:tint="@color/primary" android:tag="i:ic_mic" />
        <LinearLayout android:layout_width="0dp" android:layout_height="42dp" android:layout_marginStart="12dp" android:layout_weight="1" android:background="@drawable/bg_chip" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="12dp">
            <EditText android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text_gray" android:textSize="16sp" android:tag="t:Aa" android:id="@+id/messageInput" android:hint="Aa" android:background="@android:color/transparent" />
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="Emoji" android:src="@drawable/ic_emoji" app:tint="@color/primary" android:tag="i:ic_emoji" />
        </LinearLayout>
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="12dp" android:contentDescription="Like" android:src="@drawable/ic_thumb" app:tint="@color/primary" android:tag="i:ic_thumb" />
    </LinearLayout>
</LinearLayout>