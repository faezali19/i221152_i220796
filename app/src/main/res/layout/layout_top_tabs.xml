<?xml version="1.0" encoding="utf-8"?>
<!-- Shared header (title, search, messenger) + 5 tabs. Used by Home, Friends, Marketplace, Notifications, Menu. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Row 1: title + search + messenger -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="kinnect"
            android:textColor="@color/primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- Search button -->
        <FrameLayout
            android:id="@+id/btnSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_gray"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Search"
                android:src="@drawable/ic_search"
                app:tint="@color/text_dark" />
        </FrameLayout>

        <!-- Messenger button with red badge "3" -->
        <FrameLayout
            android:id="@+id/btnMessenger"
            android:layout_width="50dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|start"
                android:background="@drawable/bg_circle_gray">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Messages"
                    android:src="@drawable/ic_messenger"
                    app:tint="@color/text_dark" />
            </FrameLayout>

            <TextView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <!-- Row 2: five tabs. The teal underline (ul...) is shown only on the active tab. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/icHome"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="Home"
                android:src="@drawable/ic_home"
                app:tint="@color/text_dark" />

            <View
                android:id="@+id/ulHome"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:background="@color/primary"
                android:visibility="invisible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tabFriends"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/icFriends"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="Friends"
                android:src="@drawable/ic_people"
                app:tint="@color/text_dark" />

            <View
                android:id="@+id/ulFriends"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:background="@color/primary"
                android:visibility="invisible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tabMarket"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/icMarket"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="Marketplace"
                android:src="@drawable/ic_store"
                app:tint="@color/text_dark" />

            <View
                android:id="@+id/ulMarket"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:background="@color/primary"
                android:visibility="invisible" />
        </FrameLayout>

        <!-- Notifications tab with red badge "5" -->
        <FrameLayout
            android:id="@+id/tabNotif"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/icNotif"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="bottom|start"
                    android:contentDescription="Notifications"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/text_dark" />

                <TextView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:text="5"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <View
                android:id="@+id/ulNotif"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:background="@color/primary"
                android:visibility="invisible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tabMenu"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/icMenu"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="Menu"
                android:src="@drawable/ic_menu"
                app:tint="@color/text_dark" />

            <View
                android:id="@+id/ulMenu"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:background="@color/primary"
                android:visibility="invisible" />
        </FrameLayout>
    </LinearLayout>

    <!-- Thin line under the tabs -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_light" />
</LinearLayout>