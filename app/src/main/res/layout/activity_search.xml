<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/white" android:orientation="vertical">

    <!-- Search field row -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
        <ImageView android:id="@+id/btnBack" android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="Back" android:src="@drawable/ic_arrow_back" app:tint="@color/text_dark" />
        <LinearLayout android:layout_width="0dp" android:layout_height="46dp" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/bg_chip" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="10dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Search" android:src="@drawable/ic_search" app:tint="@color/text_gray" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="omar" android:textColor="@color/text_dark" android:textSize="17sp" />
            <FrameLayout android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_avatar" android:backgroundTint="@color/text_gray">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="center" android:contentDescription="Clear" android:src="@drawable/ic_close" app:tint="@color/white" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Filter chips -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="42dp" android:background="@drawable/bg_chip_selected" android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp" android:text="All" android:textColor="@color/primary" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="8dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp" android:text="People" android:textColor="@color/text_dark" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="8dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp" android:text="Posts" android:textColor="@color/text_dark" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="8dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp" android:text="Groups" android:textColor="@color/text_dark" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="8dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp" android:text="Marketplace" android:textColor="@color/text_dark" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke_light" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="People" android:textColor="@color/text_dark" android:textSize="22sp" android:textStyle="bold" />

            <!-- Omar Farooq -->
            <LinearLayout android:id="@+id/rowOmar" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="6dp">
                <TextView android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_avatar" android:backgroundTint="@color/av_green" android:gravity="center" android:text="OF" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Omar Farooq" android:textColor="@color/text_dark" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Friend · Lives in Karachi" android:textColor="@color/text_gray" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Omar Siddiqui -->
            <LinearLayout android:id="@+id/rowOmarS" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp">
                <TextView android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_avatar" android:backgroundTint="@color/av_indigo" android:gravity="center" android:text="OS" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Omar Siddiqui" android:textColor="@color/text_dark" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12 mutual friends · FAST-NUCES" android:textColor="@color/text_gray" android:textSize="14sp" />
                </LinearLayout>
                <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_circle_teal_light">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:contentDescription="Add friend" android:src="@drawable/ic_person_add" app:tint="@color/primary" />
                </FrameLayout>
            </LinearLayout>

            <!-- Omar Tariq -->
            <LinearLayout android:id="@+id/rowOmarT" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp">
                <TextView android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_avatar" android:backgroundTint="@color/av_brown" android:gravity="center" android:text="OT" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Omar Tariq" android:textColor="@color/text_dark" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Works at Daraz · 3 mutual friends" android:textColor="@color/text_gray" android:textSize="14sp" />
                </LinearLayout>
                <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_circle_teal_light">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:contentDescription="Add friend" android:src="@drawable/ic_person_add" app:tint="@color/primary" />
                </FrameLayout>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:background="@drawable/bg_btn_gray" android:gravity="center" android:text="See all people" android:textColor="@color/text_dark" android:textSize="16sp" android:textStyle="bold" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Groups" android:textColor="@color/text_dark" android:textSize="22sp" android:textStyle="bold" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="6dp">
                <TextView android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_sq_avatar" android:backgroundTint="@color/av_purple" android:gravity="center" android:text="OP" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Omar's Photography Circle" android:textColor="@color/text_dark" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Public · 2.4K members · 10+ posts a day" android:textColor="@color/text_gray" android:textSize="14sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginStart="8dp" android:background="@drawable/bg_button_primary" android:gravity="center" android:paddingStart="22dp" android:paddingEnd="22dp" android:text="Join" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Recent searches" android:textColor="@color/text_dark" android:textSize="22sp" android:textStyle="bold" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="6dp">
                <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_circle_gray"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:contentDescription="Recent" android:src="@drawable/ic_clock" app:tint="@color/text_dark" /></FrameLayout>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="lina marsh" android:textColor="@color/text_dark" android:textSize="17sp" />
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="Remove" android:src="@drawable/ic_close" app:tint="@color/text_gray" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp">
                <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_circle_gray"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:contentDescription="Recent" android:src="@drawable/ic_clock" app:tint="@color/text_dark" /></FrameLayout>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="study desk karachi" android:textColor="@color/text_dark" android:textSize="17sp" />
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="Remove" android:src="@drawable/ic_close" app:tint="@color/text_gray" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp">
                <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_circle_gray"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:contentDescription="Recent" android:src="@drawable/ic_clock" app:tint="@color/text_dark" /></FrameLayout>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="SMD Class of 2026" android:textColor="@color/text_dark" android:textSize="17sp" />
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="Remove" android:src="@drawable/ic_close" app:tint="@color/text_gray" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>