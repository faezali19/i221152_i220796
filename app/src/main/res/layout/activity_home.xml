<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/homeFeedRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white" android:orientation="vertical">

    
    <include layout="@layout/layout_top_tabs" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">

                <TextView android:id="@+id/composerAvatar" android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_avatar" android:gravity="center" android:text="JW" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:tag="t:JW" />

                <TextView android:id="@+id/composerBox" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/bg_pill" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="16dp" android:text="What's on your mind, Jacob?" android:textColor="@color/text_gray" android:textSize="15sp" android:tag="t:What\'s on your mind, Jacob?" />

                <ImageView android:id="@+id/btnPhotoIcon" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginStart="12dp" android:contentDescription="Photo" android:src="@drawable/ic_image" app:tint="@color/primary" android:tag="i:ic_image" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="8dp" android:background="@color/divider_thick" />

            
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="12dp" android:paddingTop="12dp" android:paddingEnd="4dp" android:paddingBottom="12dp">

                    
                    <com.google.android.material.card.MaterialCardView android:id="@+id/storyCreate" android:layout_width="96dp" android:layout_height="162dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/white" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:strokeColor="@color/stroke_light" app:strokeWidth="1dp">

                        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">

                            <View android:layout_width="match_parent" android:layout_height="108dp" android:background="@color/story_create_bg" />

                            <TextView android:layout_width="60dp" android:layout_height="60dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="22dp" android:background="@drawable/bg_avatar" android:gravity="center" android:text="JW" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" android:tag="t:JW" />

                            
                            <FrameLayout android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="94dp" android:background="@drawable/bg_avatar_ring">

                                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="center" android:contentDescription="Create story" android:src="@drawable/ic_plus" app:tint="@color/white" android:tag="i:ic_plus" />
                            </FrameLayout>

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="10dp" android:text="Create story" android:textColor="@color/text_dark" android:textSize="12sp" android:textStyle="bold" android:tag="t:Create story" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    
                    <com.google.android.material.card.MaterialCardView android:id="@+id/storyOmar" android:layout_width="96dp" android:layout_height="162dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="14dp" app:cardElevation="0dp">

                        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">

                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ph_navy" android:contentDescription="@null" android:scaleType="centerCrop" android:src="@drawable/ph_scene" android:tag="i:ph_scene" />

                            <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="top|start" android:layout_margin="8dp" android:background="@drawable/bg_story_ring">

                                <TextView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:background="@drawable/bg_avatar" android:backgroundTint="@color/av_green" android:gravity="center" android:text="OF" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:tag="t:OF" />
                            </FrameLayout>

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:layout_margin="8dp" android:text="Omar Farooq" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" android:tag="t:Omar Farooq" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    
                    <com.google.android.material.card.MaterialCardView android:layout_width="96dp" android:layout_height="162dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="14dp" app:cardElevation="0dp">

                        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">

                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ph_pink" android:contentDescription="@null" android:scaleType="centerCrop" android:src="@drawable/ph_scene" android:tag="i:ph_scene" />

                            <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="top|start" android:layout_margin="8dp" android:background="@drawable/bg_story_ring">

                                <TextView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:background="@drawable/bg_avatar" android:backgroundTint="@color/av_indigo" android:gravity="center" android:text="SI" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:tag="t:SI" />
                            </FrameLayout>

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:layout_margin="8dp" android:text="Sara Iqbal" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" android:tag="t:Sara Iqbal" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    
                    <com.google.android.material.card.MaterialCardView android:layout_width="96dp" android:layout_height="162dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="14dp" app:cardElevation="0dp">

                        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">

                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ph_green" android:contentDescription="@null" android:scaleType="centerCrop" android:src="@drawable/ph_scene" android:tag="i:ph_scene" />

                            <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="top|start" android:layout_margin="8dp" android:background="@drawable/bg_story_ring">

                                <TextView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:background="@drawable/bg_avatar" android:backgroundTint="@color/av_brown" android:gravity="center" android:text="HA" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:tag="t:HA" />
                            </FrameLayout>

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:layout_margin="8dp" android:text="Hamza Ali" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" android:tag="t:Hamza Ali" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </HorizontalScrollView>

            <View android:layout_width="match_parent" android:layout_height="8dp" android:background="@color/divider_thick" />

            
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/feedList" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" /></LinearLayout>
    </ScrollView>
</LinearLayout>