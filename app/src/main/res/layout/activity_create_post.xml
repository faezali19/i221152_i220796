<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/createPostRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:paddingEnd="10dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/kn_s3_029"
            android:padding="15dp"
            app:tint="@color/text_dark"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/kn_s3_030"
            android:textSize="18sp"
            android:textColor="@color/text_dark"
            android:textStyle="bold"
            android:fontFamily="sans-serif" />

        <FrameLayout
            android:id="@+id/btnPost"
            android:layout_width="68dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="60dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_kn_post_button"
                android:text="@string/kn_s3_028"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8E8E8" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:background="@drawable/bg_avatar"
                    android:backgroundTint="@color/primary"
                    android:text="@string/kn_s3_023"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/kn_s3_024"
                        android:textSize="14sp"
                        android:textColor="@color/text_dark"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="7dp"
                            android:paddingEnd="5dp"
                            android:background="@drawable/bg_kn_post_audience">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_globe"
                                android:contentDescription="@null"
                                app:tint="@color/primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="@string/kn_s3_025"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary"
                                android:includeFontPadding="false"
                                android:fontFamily="sans-serif" />

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginStart="4dp"
                                android:src="@drawable/ic_chevron_down"
                                android:contentDescription="@null"
                                app:tint="@color/primary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginStart="6dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="7dp"
                            android:paddingEnd="5dp"
                            android:background="@drawable/bg_kn_post_audience">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_plus"
                                android:contentDescription="@null"
                                app:tint="@color/primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="@string/kn_s3_026"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary"
                                android:includeFontPadding="false"
                                android:fontFamily="sans-serif" />

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginStart="4dp"
                                android:src="@drawable/ic_chevron_down"
                                android:contentDescription="@null"
                                app:tint="@color/primary" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <EditText
                android:id="@+id/postText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/kn_s3_027"
                android:textSize="20sp"
                android:gravity="top"
                android:background="@android:color/transparent"
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="80dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:includeFontPadding="false"
                android:textColor="@color/text_dark"
                android:fontFamily="sans-serif" />

            <HorizontalScrollView
                android:id="@+id/postMediaPreview"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/postMediaItems"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="7dp"
                        android:gravity="center"
                        android:background="@drawable/bg_kn_post_aa"
                        android:text="@string/kn_s3_001"
                        android:textSize="12sp"
                        android:textColor="@color/text_dark"
                        android:includeFontPadding="false"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="7dp"
                        android:gravity="center"
                        android:background="@drawable/bg_kn_post_swatch"
                        android:backgroundTint="#0B5F63"
                        android:text="@string/kn_s3_002"
                        android:textSize="12sp"
                        android:textColor="@color/text_dark"
                        android:includeFontPadding="false"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="7dp"
                        android:gravity="center"
                        android:background="@drawable/bg_kn_post_swatch"
                        android:backgroundTint="#B94A2C"
                        android:text="@string/kn_s3_003"
                        android:textSize="12sp"
                        android:textColor="@color/text_dark"
                        android:includeFontPadding="false"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="7dp"
                        android:gravity="center"
                        android:background="@drawable/bg_kn_post_swatch"
                        android:backgroundTint="#4E4E8E"
                        android:text="@string/kn_s3_004"
                        android:textSize="12sp"
                        android:textColor="@color/text_dark"
                        android:includeFontPadding="false"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="7dp"
                        android:gravity="center"
                        android:background="@drawable/bg_kn_post_swatch"
                        android:backgroundTint="#2F6E4E"
                        android:text="@string/kn_s3_005"
                        android:textSize="12sp"
                        android:textColor="@color/text_dark"
                        android:includeFontPadding="false"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="7dp"
                        android:gravity="center"
                        android:background="@drawable/bg_kn_post_swatch"
                        android:backgroundTint="#C98A12"
                        android:text="@string/kn_s3_006"
                        android:textSize="12sp"
                        android:textColor="@color/text_dark"
                        android:includeFontPadding="false"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="7dp"
                        android:gravity="center"
                        android:background="@drawable/bg_kn_post_swatch"
                        android:backgroundTint="#7B4F7E"
                        android:text="@string/kn_s3_007"
                        android:textSize="12sp"
                        android:textColor="@color/text_dark"
                        android:includeFontPadding="false"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="7dp"
                        android:gravity="center"
                        android:background="@drawable/bg_kn_post_swatch"
                        android:backgroundTint="#1E1E1E"
                        android:text="@string/kn_s3_008"
                        android:textSize="12sp"
                        android:textColor="@color/text_dark"
                        android:includeFontPadding="false"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_kn_post_options"
                android:padding="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="12dp"
                android:elevation="8dp">

                <View
                    android:layout_width="36dp"
                    android:layout_height="3dp"
                    android:layout_gravity="center"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_kn_post_handle" />

                <LinearLayout
                    android:id="@+id/btnPostPhotos"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="48dp"
                        android:paddingStart="11dp"
                        android:paddingEnd="11dp"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp"
                        android:src="@drawable/ic_image"
                        android:contentDescription="@string/kn_s3_009"
                        app:tint="#2F6E4E" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/kn_s3_010"
                        android:textSize="14sp"
                        android:textColor="@color/text_dark"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="48dp"
                        android:paddingStart="11dp"
                        android:paddingEnd="11dp"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp"
                        android:src="@drawable/ic_tag"
                        android:contentDescription="@string/kn_s3_011"
                        app:tint="#3E6E8E" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/kn_s3_012"
                        android:textSize="14sp"
                        android:textColor="@color/text_dark"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="48dp"
                        android:paddingStart="11dp"
                        android:paddingEnd="11dp"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp"
                        android:src="@drawable/ic_emoji"
                        android:contentDescription="@string/kn_s3_013"
                        app:tint="#C98A12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/kn_s3_014"
                        android:textSize="14sp"
                        android:textColor="@color/text_dark"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="48dp"
                        android:paddingStart="11dp"
                        android:paddingEnd="11dp"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp"
                        android:src="@drawable/ic_pin"
                        android:contentDescription="@string/kn_s3_015"
                        app:tint="#B94A2C" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/kn_s3_016"
                        android:textSize="14sp"
                        android:textColor="@color/text_dark"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="48dp"
                        android:paddingStart="11dp"
                        android:paddingEnd="11dp"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp"
                        android:src="@drawable/ic_video"
                        android:contentDescription="@string/kn_s3_017"
                        app:tint="#9E3A4E" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/kn_s3_018"
                        android:textSize="14sp"
                        android:textColor="@color/text_dark"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPostCamera"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="48dp"
                        android:paddingStart="11dp"
                        android:paddingEnd="11dp"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp"
                        android:src="@drawable/ic_kn_post_camera"
                        android:contentDescription="@string/kn_s3_019"
                        app:tint="#0B5F63" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/kn_s3_020"
                        android:textSize="14sp"
                        android:textColor="@color/text_dark"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="48dp"
                        android:paddingStart="11dp"
                        android:paddingEnd="11dp"
                        android:paddingTop="15dp"
                        android:paddingBottom="15dp"
                        android:src="@drawable/ic_calendar"
                        android:contentDescription="@string/kn_s3_021"
                        app:tint="#4E4E8E" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/kn_s3_022"
                        android:textSize="14sp"
                        android:textColor="@color/text_dark"
                        android:fontFamily="sans-serif" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>