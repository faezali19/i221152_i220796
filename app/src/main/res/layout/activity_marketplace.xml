<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white" android:orientation="vertical">

    <include layout="@layout/layout_top_tabs" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">

            
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:id="@+id/btnSell" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="Sell" android:src="@drawable/ic_pencil" app:tint="@color/text_dark" android:tag="i:ic_pencil" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Sell" android:textColor="@color/text_dark" android:textSize="16sp" android:textStyle="bold" android:tag="t:Sell" />
                </LinearLayout>
                <LinearLayout android:id="@+id/btnCategories" android:layout_width="0dp" android:layout_height="46dp" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="Categories" android:src="@drawable/ic_grid" app:tint="@color/text_dark" android:tag="i:ic_grid" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Categories" android:textColor="@color/text_dark" android:textSize="16sp" android:textStyle="bold" android:tag="t:Categories" />
                </LinearLayout>
            </LinearLayout>

            
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Today's picks" android:textColor="@color/text_dark" android:textSize="22sp" android:textStyle="bold" android:tag="t:Today\'s picks" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:contentDescription="Location" android:src="@drawable/ic_pin" app:tint="@color/primary" android:tag="i:ic_pin" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="Karachi · 40 km" android:textColor="@color/primary" android:textSize="14sp" android:textStyle="bold" android:tag="t:Karachi · 40 km" />
            </LinearLayout>

            
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/listingsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" /></LinearLayout>
    </ScrollView>
</LinearLayout>