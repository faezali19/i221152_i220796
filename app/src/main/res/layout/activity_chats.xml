<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ns1="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white" android:orientation="vertical">

    
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
        <ImageView android:id="@+id/btnBack" android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="Back" android:src="@drawable/ic_arrow_back" ns1:tint="@color/text_dark" android:tag="i:ic_arrow_back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="Chats" android:textColor="@color/text_dark" android:textSize="28sp" android:textStyle="bold" android:tag="t:Chats" />
        <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_circle_gray">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:contentDescription="New chat" android:src="@drawable/ic_pencil" ns1:tint="@color/text_dark" android:tag="i:ic_pencil" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            
            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:background="@drawable/bg_chip" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Search" android:src="@drawable/ic_search" ns1:tint="@color/text_gray" android:tag="i:ic_search" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Search" android:textColor="@color/text_gray" android:textSize="16sp" android:tag="t:Search" />
            </LinearLayout>

            
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/chatsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" /></LinearLayout>
    </ScrollView>

    
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke_light" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="Chats" android:src="@drawable/ic_messenger" ns1:tint="@color/primary" android:tag="i:ic_messenger" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chats" android:textColor="@color/primary" android:textSize="13sp" android:textStyle="bold" android:tag="t:Chats" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="People" android:src="@drawable/ic_people" ns1:tint="@color/text_gray" android:tag="i:ic_people" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="People" android:textColor="@color/text_gray" android:textSize="13sp" android:textStyle="bold" android:tag="t:People" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="Stories" android:src="@drawable/ic_reels" ns1:tint="@color/text_gray" android:tag="i:ic_reels" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stories" android:textColor="@color/text_gray" android:textSize="13sp" android:textStyle="bold" android:tag="t:Stories" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>