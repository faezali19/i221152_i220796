<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/white" android:orientation="vertical">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
        <ImageView android:id="@+id/btnBack" android:layout_width="28dp" android:layout_height="28dp"
            android:contentDescription="Back" android:src="@drawable/ic_arrow_back" app:tint="@color/text_dark" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1"
            android:text="Chats" android:textColor="@color/text_dark" android:textSize="28sp" android:textStyle="bold" />
        <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_circle_gray">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                android:contentDescription="New chat" android:src="@drawable/ic_pencil" app:tint="@color/text_dark" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <!-- Search bar -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:background="@drawable/bg_chip"
                android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Search"
                    android:src="@drawable/ic_search" app:tint="@color/text_gray" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
                    android:text="Search" android:textColor="@color/text_gray" android:textSize="16sp" />
            </LinearLayout>

            <!-- Notes / active people row -->
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingStart="12dp" android:paddingTop="14dp" android:paddingEnd="12dp" android:paddingBottom="8dp">

                    <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
                        <FrameLayout android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_circle_gray">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                                android:contentDescription="Your note" android:src="@drawable/ic_plus" app:tint="@color/text_dark" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                            android:text="Your note" android:textColor="@color/text_gray" android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
                        <FrameLayout android:layout_width="62dp" android:layout_height="62dp">
                            <TextView android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_avatar" android:backgroundTint="@color/av_crimson"
                                android:gravity="center" android:text="AK" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
                            <View android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="bottom|end" android:background="@drawable/bg_online_dot" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                            android:text="Aisha" android:textColor="@color/text_gray" android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
                        <FrameLayout android:layout_width="62dp" android:layout_height="62dp">
                            <TextView android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_avatar" android:backgroundTint="@color/av_green"
                                android:gravity="center" android:text="OF" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
                            <View android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="bottom|end" android:background="@drawable/bg_online_dot" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                            android:text="Omar" android:textColor="@color/text_gray" android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
                        <FrameLayout android:layout_width="62dp" android:layout_height="62dp">
                            <TextView android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_avatar" android:backgroundTint="@color/av_indigo"
                                android:gravity="center" android:text="SI" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
                            <View android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="bottom|end" android:background="@drawable/bg_online_dot" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                            android:text="Sara" android:textColor="@color/text_gray" android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
                        <FrameLayout android:layout_width="62dp" android:layout_height="62dp">
                            <TextView android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_avatar" android:backgroundTint="@color/av_brown"
                                android:gravity="center" android:text="HA" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
                            <View android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="bottom|end" android:background="@drawable/bg_online_dot" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                            android:text="Hamza" android:textColor="@color/text_gray" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Row 1: Aisha Khan (unread) -->
            <LinearLayout android:id="@+id/chatRow1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
                <FrameLayout android:layout_width="56dp" android:layout_height="56dp">
                    <TextView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_avatar" android:backgroundTint="@color/av_crimson"
                        android:gravity="center" android:text="AK" android:textColor="@color/white" android:textSize="19sp" android:textStyle="bold" />
                    <View android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="bottom|end" android:background="@drawable/bg_online_dot" />
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aisha Khan" android:textColor="@color/text_dark" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sending the photos tonight · 2m" android:textColor="@color/text_dark" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/bg_avatar" />
            </LinearLayout>

            <!-- Row 2: Design crew (group, unread) -->
            <LinearLayout android:id="@+id/chatRow2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
                <FrameLayout android:layout_width="56dp" android:layout_height="56dp">
                    <TextView android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="top|start" android:background="@drawable/bg_avatar" android:backgroundTint="@color/av_olive"
                        android:gravity="center" android:text="MC" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />
                    <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="bottom|start" android:background="@drawable/bg_circle_white">
                        <TextView android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="center" android:background="@drawable/bg_avatar" android:backgroundTint="@color/av_steel"
                            android:gravity="center" android:text="ZR" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />
                    </FrameLayout>
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Design crew" android:textColor="@color/text_dark" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Maya: the new mockups look clean · 15m" android:textColor="@color/text_dark" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/bg_avatar" />
            </LinearLayout>

            <!-- Row 3: Lina Marsh -->
            <LinearLayout android:id="@+id/chatRow3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
                <TextView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_avatar" android:backgroundTint="@color/av_purple"
                    android:gravity="center" android:text="LM" android:textColor="@color/white" android:textSize="19sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lina Marsh" android:textColor="@color/text_dark" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="You: See you at the pier · 1h" android:textColor="@color/text_gray" android:textSize="14sp" />
                </LinearLayout>
                <View android:layout_width="14dp" android:layout_height="14dp" android:background="@drawable/bg_avatar" android:backgroundTint="@color/av_crimson" />
            </LinearLayout>

            <!-- Row 4: Omar Farooq -->
            <LinearLayout android:id="@+id/chatRow4" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
                <FrameLayout android:layout_width="56dp" android:layout_height="56dp">
                    <TextView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_avatar" android:backgroundTint="@color/av_green"
                        android:gravity="center" android:text="OF" android:textColor="@color/white" android:textSize="19sp" android:textStyle="bold" />
                    <View android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="bottom|end" android:background="@drawable/bg_online_dot" />
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Omar Farooq" android:textColor="@color/text_dark" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Haha that story was wild · 3h" android:textColor="@color/text_gray" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 5: Bilal Ahmed -->
            <LinearLayout android:id="@+id/chatRow5" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
                <TextView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_avatar" android:backgroundTint="@color/av_purple"
                    android:gravity="center" android:text="BA" android:textColor="@color/white" android:textSize="19sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bilal Ahmed" android:textColor="@color/text_dark" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thanks, bro! · Mon" android:textColor="@color/text_gray" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 6: Noor Fatima -->
            <LinearLayout android:id="@+id/chatRow6" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
                <TextView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_avatar" android:backgroundTint="@color/av_green"
                    android:gravity="center" android:text="NF" android:textColor="@color/white" android:textSize="19sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Noor Fatima" android:textColor="@color/text_dark" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="You: Happy birthday! · Sun" android:textColor="@color/text_gray" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom bar: Chats / People / Stories -->
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke_light" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="Chats" android:src="@drawable/ic_messenger" app:tint="@color/primary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chats" android:textColor="@color/primary" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="People" android:src="@drawable/ic_people" app:tint="@color/text_gray" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="People" android:textColor="@color/text_gray" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="Stories" android:src="@drawable/ic_reels" app:tint="@color/text_gray" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stories" android:textColor="@color/text_gray" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>